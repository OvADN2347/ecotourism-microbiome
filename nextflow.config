/*
 * Nextflow config for nf-core/ampliseq on SLURM HPC
 * - Default processes run on: partition=general, qos=general
 * - DADA2 denoising runs on:  partition=himem,   qos=himem
 * - Singularity cache in $HOME
 */

process {
  executor = 'slurm'

  // Defaults for most steps
  queue    = 'general'
  cpus     = 8
  memory   = '16 GB'
  time     = '12h'

  // IMPORTANT: match QOS to partition
  clusterOptions = '--qos=general'

  errorStrategy = 'retry'
  maxRetries    = 1

  /*
   * Send DADA2 denoising to high-memory partition/QOS
   */
  withName: 'NFCORE_AMPLISEQ:AMPLISEQ:DADA2_DENOISING' {
    queue  = 'himem'
    clusterOptions = '--qos=himem'

    // Adjust if needed; 16 is a safer starting point than 32
    cpus   = 16
    memory = '64 GB'
    time   = '24h'
  }

  /*
   * Optional: enable if you see memory issues later
   */
  // withName: 'NFCORE_AMPLISEQ:AMPLISEQ:DADA2_MERGEPAIRS' {
  //   queue  = 'himem'
  //   clusterOptions = '--qos=himem'
  //   cpus   = 8
  //   memory = '64 GB'
  //   time   = '24h'
  // }
  // withName: 'NFCORE_AMPLISEQ:AMPLISEQ:DADA2_MAKESEQTABLE' {
  //   queue  = 'himem'
  //   clusterOptions = '--qos=himem'
  //   cpus   = 4
  //   memory = '32 GB'
  //   time   = '12h'
  // }
}

singularity {
  enabled    = true
  autoMounts = true
  cacheDir   = "$HOME/.singularity_cache"
}

/*
 * Avoid "report file already exists" if you ever re-run to same OUTDIR
 */
report   { overwrite = true }
timeline { overwrite = true }
trace    { overwrite = true }
